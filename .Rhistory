# 2nd boxplot: visualization of strafication (increasing number of alignment tend to reduce cell fitness)
visualize_stratify_alignment <- function(library_lfc_data, boxplot_output_name) {
boxplot_lfc <- library_lfc_data %>%
ggplot(aes(alignment_bin, mean, group = alignment_bin)) +
geom_boxplot(outlier.shape = NA, size = 0.5) +
theme_minimal() +
geom_hline(yintercept = 0, linetype = "dashed", color = "black", size = 0.5) +
geom_hline(yintercept = -1, linetype = "dashed", color = "black", size = 0.5) +
scale_y_continuous(limits = c(-3, 2), breaks = seq(-3, 2, by = 1)) +
labs(title = "",
x = "Number of perfect on-target alignment",
y = "Averaged median sgRNA Log2FC") +
theme(
axis.text.x = element_text(size = 12, vjust = 0.7, colour = "black"),
axis.text.y = element_text(size = 12, colour = "black"),
axis.title.x = element_text(size = 12, margin = margin(t = 10)),
axis.title.y = element_text(size = 12, margin = margin(r = 10)),
axis.ticks = element_line(size = 1.5),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
axis.line.x = element_line(size = 0.5),
axis.line.y = element_line(size = 0.5),
line = element_line((size = 2), colour = 'black'))
ggsave(
path = './',
width = 4,
height = 5,
dpi = 1000,
plot = boxplot_lfc,
filename = boxplot_output_name)
}
visualize_stratify_alignment(avana_library_and_lfc_data[[2]], "../figure/03_fig_analysis_lfc_off-target-sgrna/avana_multi_target.png")
visualize_stratify_alignment(tkov3_library_and_lfc_data[[2]], "../figure/03_fig_analysis_lfc_off-target-sgrna/tkov3_multi_target.png")
visualize_stratify_alignment(brunello_library_and_lfc_data[[2]], "../figure/03_fig_analysis_lfc_off-target-sgrna/brunello_multi_target.png")
visualize_stratify_alignment(yusa_library_and_lfc_data[[2]], "../figure/03_fig_analysis_lfc_off-target-sgrna/yusa_multi_target.png")
visualize_stratify_alignment(jacquere_library_and_lfc_data[[2]], "../figure/03_fig_analysis_lfc_off-target-sgrna/jacquere_multi_target.png")
calculate_wilcoxon_cliff <- function(input_data, which_guides) {
input_data[[1]]$alignment <- factor(input_data[[1]]$alignment, levels = c(which_guides, "perfect"))
wilcox.test(input_data[[1]]$mean ~ input_data[[1]]$alignment, alternative = "less")
cliff.delta(mean ~ alignment, data = input_data[[1]])
}
calculate_wilcoxon_cliff(avana_library_and_lfc_data[[1]], "multi-target guides")
calculate_wilcoxon_cliff(avana_library_and_lfc_data, "multi-target guides")
calculate_wilcoxon_cliff(brunello_library_and_lfc_data, "multi-target guides")
calculate_wilcoxon_cliff(tkov3_library_and_lfc_data, "multi-target guides")
calculate_wilcoxon_cliff(yusa_library_and_lfc_data, "multi-target guides")
calculate_wilcoxon_cliff(jacquere_library_and_lfc_data, "multi-target guides")
