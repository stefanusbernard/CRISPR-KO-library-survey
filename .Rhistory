jacquere_classification)
avana_library_and_lfc_data <- avana_library_and_lfc_data %>% mutate(library = "avana")
tkov3_library_and_lfc_data <- tkov3_library_and_lfc_data %>% mutate(library = "toronto_v3")
yusa_library_and_lfc_data <- yusa_library_and_lfc_data %>% mutate(library = "yusa")
brunello_library_and_lfc_data <- brunello_library_and_lfc_data %>% mutate(library = "brunello")
jacquere_library_and_lfc_data <- jacquere_library_and_lfc_data %>% mutate(library = "jacquere")
source("./00_CRISPR-KO-library-survey-functions.R")
combined_data <- rbind(avana_library_and_lfc_data,
tkov3_library_and_lfc_data,
yusa_library_and_lfc_data,
brunello_library_and_lfc_data,
jacquere_library_and_lfc_data)
combined_data <- combined_data %>% mutate(library = factor(library, levels = c("brunello", "toronto_v3", "yusa", "avana", "jacquere")))
