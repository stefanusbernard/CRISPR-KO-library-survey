#                                       '../Chapter-1-data/02_MAGeCK_MLE_Analysis/Module_2_Cellecta_150K_norm_mageck_complete_analysis/Module_2_Cellecta_150K_norm_mageck_mle/M2_Cellecta_150K_norm.gene_summary.txt')
