#                                       '../Chapter-1-data/02_MAGeCK_MLE_Analysis/Module_3_Cellecta_150K_norm_mageck_complete_analysis/Module_3_Cellecta_150K_norm_mageck_mle/M3_Cellecta_150K_norm.gene_summary.txt')
# For refined library use this
M1_gdata <- function_import_flute_mle('../Chapter-1-data/02_MAGeCK_MLE_Analysis/MAGeCKFlute_M1_50K_Flute_MLE/QC/M1_50K_Flute_MLE_processed_data.txt',
'../Chapter-1-data/02_MAGeCK_MLE_Analysis/Module_1_Cellecta_50K_norm_corrected_mageck_complete_analysis/Module_1_Cellecta_50K_norm_corrected_mageck_mle/M1_Cellecta_50K_norm_corrected.gene_summary.txt')
M2_gdata <- function_import_flute_mle('../Chapter-1-data/02_MAGeCK_MLE_Analysis/MAGeCKFlute_M2_46K_Flute_MLE/QC/M2_46K_Flute_MLE_processed_data.txt',
'../Chapter-1-data/02_MAGeCK_MLE_Analysis/Module_2_Cellecta_46K_norm_corrected_mageck_complete_analysis/Module_2_Cellecta_46K_norm_corrected_mageck_mle/M2_Cellecta_46K_norm_corrected.gene_summary.txt')
M3_gdata <- function_import_flute_mle('../Chapter-1-data/02_MAGeCK_MLE_Analysis/MAGeCKFlute_M3_43K_Flute_MLE/QC/M3_43K_Flute_MLE_processed_data.txt',
'../Chapter-1-data/02_MAGeCK_MLE_Analysis/Module_3_Cellecta_43K_norm_corrected_mageck_complete_analysis/Module_3_Cellecta_43K_norm_corrected_mageck_mle/M3_Cellecta_43K_norm_corrected.gene_summary.txt')
M1 <- function_flute_outlier(gdata = M1_gdata)
function_flute_outlier <- function(gdata) {
gdata$Rank = rank(gdata$Diff)
control <- c('Neg_Control', 'INTRON_CTRL')
gdata_outlier <- gdata %>%
dplyr::select(Gene, HumanGene, sgRNA, DAY20_DMSO, DAY24_XL413, Diff, Rank) %>%
filter(!Gene %in% control)
lower_outlier_limit <- -CutoffCalling(gdata_outlier$Diff, scale = 3)
upper_outlier_limit <- CutoffCalling(gdata_outlier$Diff, scale = 3)
print(paste(c('Lower outlier limit is: '), lower_outlier_limit))
print(paste(c('Upper outlier limit is: '), upper_outlier_limit))
gdata_outlier <- gdata_outlier %>%
mutate(outlier = case_when(Diff < lower_outlier_limit ~ 'sensitize the cell to the treatment',
Diff > upper_outlier_limit ~ 'promoting resistance to the treatment',
TRUE ~ 'not outlier'))
gdata_outlier_lower <- gdata_outlier %>%
filter(Diff < lower_outlier_limit) %>%
arrange(Rank)
gdata_outlier_upper <- gdata_outlier %>%
filter(Diff > upper_outlier_limit) %>%
arrange(Rank)
return(list(gdata_outlier_lower, gdata_outlier_upper, gdata_outlier))
}
