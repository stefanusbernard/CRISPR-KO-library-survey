function_processing <- function(module_csv, library_selected) {
sgRNA_library <- read_csv(module_csv)
sgRNA_library <- sgRNA_library %>%
mutate(sequence_cut = str_sub(sequence, 22, -26)) %>%
select(-sequence) %>%
separate_wider_delim(Label,'|', names = c('sgRNA', 'gene')) %>%
mutate(gene = str_replace_all(gene, pattern = "_a", replacement = '')) %>%
relocate(sequence_cut, .after=sgRNA) %>%
dplyr::rename('spacer' = 'sequence_cut') %>%
filter(sgRNA %in% library_selected$sgRNA)
return(sgRNA_library)
}
function_mle <- function(dataset_gene_mle, project_name) {
data <- read.delim(dataset_gene_mle)
FluteMLE(data, treatname = 'DAY24_XL413', ctrlname = 'DAY20_DMSO',
proj = project_name, organism = 'hsa', incorporateDepmap = TRUE, cell_lines = 'MCF10A')
}
function_import_flute_mle <- function(processed_data_mle, gene_summary_txt_mle) {
gdata <- read.delim(processed_data_mle)
sdata <- read.delim(gene_summary_txt_mle, header = TRUE)
sdata <- sdata %>%
dplyr::select(Gene, sgRNA)
gdata <- gdata %>%
left_join(sdata, by = 'Gene') %>%
relocate(sgRNA, .after = Gene) %>%
mutate(Rank = rank(gdata$Diff))
return(gdata)
}
function_flute_outlier <- function(gdata) {
gdata$Rank = rank(gdata$Diff)
control <- c('Neg_Control', 'INTRON_CTRL')
gdata_outlier <- gdata %>%
dplyr::select(Gene, HumanGene, sgRNA, DAY20_DMSO, DAY24_XL413, Diff, Rank) %>%
filter(!Gene %in% control)
lower_outlier_limit <- -CutoffCalling(gdata_outlier$Diff, scale = 3)
upper_outlier_limit <- CutoffCalling(gdata_outlier$Diff, scale = 3)
print(paste(c('Lower outlier limit is: '), lower_outlier_limit))
print(paste(c('Upper outlier limit is: '), upper_outlier_limit))
gdata_outlier <- gdata_outlier %>%
mutate(outlier = case_when(Diff < lower_outlier_limit ~ 'sensitize the cell to the treatment',
Diff > upper_outlier_limit ~ 'promoting resistance to the treatment',
TRUE ~ 'not outlier'))
gdata_outlier_lower <- gdata_outlier %>%
filter(Diff < lower_outlier_limit) %>%
arrange(Rank)
gdata_outlier_upper <- gdata_outlier %>%
filter(Diff > upper_outlier_limit) %>%
arrange(Rank)
return(list(gdata_outlier_lower, gdata_outlier_upper, gdata_outlier))
}
function_hgnc_annotation <- function(hgnc_data, gdata, list_genes) {
hgnc_dataset <- hgnc_data %>%
filter(symbol %in% list_genes) %>%
select(symbol, name, uniprot_ids) %>%
dplyr::rename('Gene' = 'symbol')
gdata_dataset <- gdata %>%
filter(Gene %in% list_genes) %>%
left_join(hgnc_dataset, by = 'Gene') %>%
replace_na(list(name = 'unknown', uniprot_ids = 'unknown'))
return(gdata_dataset)
}
