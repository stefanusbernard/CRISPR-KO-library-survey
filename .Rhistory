terms <- c("CONTROL", "Control", "control", "INTRON", "Intron", "intron", "LacZ", "luciferase", "NO_SITE", "ONE_INTERGENIC_SITE")
# lacZ and luciferase are the control in Toronto V3 library
terms_for_filtering <- paste(terms, collapse = "|")
brunello <- 'broadgpp-brunello-library-contents'
toronto <- 'tkov3_guide_sequence'
avana <- 'avana_library'
yusa <- 'yusa_hcrispr_ko_grnas'
jacquere <- 'Jacquere_PerGuideAnnotations_Quota4'
import_report_without_control <- function(file_dir, control_terms) {
data <- read_excel(paste(file_dir))
data <- data %>% filter(!str_detect(gene, terms_for_filtering))
return(data)
}
brunello_report <- import_report_without_control(paste('~/CRISPR-KO-GuideRefine/output_cleaning/T2T-CHM13/', brunello, '_full_report.xlsx', sep = ''))
toronto_report <- import_report_without_control(paste('~/CRISPR-KO-GuideRefine/output_cleaning/T2T-CHM13/', toronto, '_full_report.xlsx', sep = ''))
avana_report <- import_report_without_control(paste('~/CRISPR-KO-GuideRefine/output_cleaning/T2T-CHM13/', avana, '_full_report.xlsx', sep = ''))
yusa_report <- import_report_without_control(paste('~/CRISPR-KO-GuideRefine/output_cleaning/T2T-CHM13/', yusa, '_full_report.xlsx', sep = ''))
jacquere_report <- import_report_without_control(paste('~/CRISPR-KO-GuideRefine/output_cleaning/T2T-CHM13/Jacquere_PerGuideAnnotations_Quota4_full_report.xlsx'))
# import predicted paralog pairs from Barbara's paper
