data_1 <- read_tsv("sample_M1_150K_48K_refined.tsv", col_names = c("sgRNA", "spacer", "gene")) %>% mutate(module = "M1")
data_2 <- read_tsv("sample_M2_150K_45K_refined.tsv", col_names = c("sgRNA", "spacer", "gene")) %>% mutate(module = "M2")
data_3 <- read_tsv("sample_M3_150K_42K_refined.tsv", col_names = c("sgRNA", "spacer", "gene")) %>% mutate(module = "M3")
data <- rbind(data_1, data_2, data_3)
data <- data %>% filter(!gene %in% c("Neg_Control", "INTRON_CTRL")) %>% select(gene, module) %>% distinct()
write.xlsx(data, "cellecta_background_genes.xlsx", row.names = FALSE)
write.xlsx(data, "cellecta_background_genes.xlsx")
