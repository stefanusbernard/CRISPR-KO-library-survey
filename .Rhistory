yusa_classification <- pick_alignment_type("../data/sgrna_lfc_data/yusa_data/yusa_sgrna_alignment_classification.csv", c("perfect", "multi-target guides", "single mismatch", "pam-distal single mismatch"))
brunello_classification <- pick_alignment_type("../data/sgrna_lfc_data/brunello_data/brunello_sgrna_alignment_classification.csv", c("perfect", "multi-target guides", "single mismatch", "pam-distal single mismatch"))
jacquere_classification <- pick_alignment_type("../data/sgrna_lfc_data/jacquere_data/jacquere_sgrna_alignment_classification.csv", c("perfect", "multi-target guides", "single mismatch", "pam-distal single mismatch"))
avana_library_and_lfc_data <- obtain_required_data("../data/library_data/avana_library.tsv",
"../data/sgrna_lfc_data/output_normalized/avana_normalized_lfc.csv",
avana_classification)
tkov3_library_and_lfc_data <- obtain_required_data("../data/library_data/tkov3_guide_sequence.tsv",
"../data/sgrna_lfc_data/output_normalized/tkov3_rpe1_normalized_lfc.csv",
